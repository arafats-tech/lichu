<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css">
    <style>
        @font-face {
            font-family: 'Noto Sans Bengali';
            src: url('public/static/NotoSansBengali-Regular.ttf') format('truetype');
        }
        
        body {
            font-family: 'Noto Sans Bengali', Arial, sans-serif;
            background-color: #1e1e2f;
            color: #e6e6e6;
            margin: 0;
            padding: 7px;
            font-size: 15px;
        }
        
        .container {
            max-width: 800px;
            margin: auto;
            background: #2d2d3e;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.4);
        }
        
        h1 {
            text-align: center;
            color: #ffffff;
            font-weight: 600;
        }

        .btn-primary {
            background-color: #4a8dd4;
            border: none;
        }
        
        .btn-primary:hover {
            background-color: #2a6ba1;
        }

        .post-count {
            font-size: 18px;
            font-weight: 600;
            color: #d3d3d3;
            text-align: right;
        }
        
        .table {
            background-color: #343a40;
            border-color: #4d4d5d;
        }
        
        .table th, .table td {
            color: #d3d3d3;
            font-weight: 500;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
        }

        .back-btn {
            display: block;
            margin: 20px auto;
            text-align: center;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="mb-4"><%= title %></h1>
        
        <div id="mainContent">
            <div class="mb-4 d-flex justify-content-between align-items-center">
                <a href="/16192224/add" class="btn btn-primary">Add New Post</a>
                <div class="post-count">Total Posts: <%= posts.length %></div>
            </div>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Content</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% posts.forEach(post => { %>
                        <tr>
                            <td><%= post.title %></td>
                            <td><%= post.content.replace(/<\/?[^>]+(>|$)/g, "").substring(0, 130) %><%= post.content.length > 130 ? '...' : '' %></td>
                            <td>
                                <div class="action-buttons">
                                    <a href="/16192224/edit?postId=<%= post.id %>" class="btn btn-primary">E</a>
                                    <a href="/16192224/delete/<%= post.id %>" class="btn btn-primary" onclick="return confirm('Are you sure you want to delete this post?');">D</a>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        
        <a href="/" class="btn btn-secondary back-btn">Back to Home</a>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>